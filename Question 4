// Define LED pins
const int redPin = 10;
const int greenPin = 7;
const int bluePin = 9;

void setup() {
  pinMode(redPin, OUTPUT);
  pinMode(greenPin, OUTPUT);
  pinMode(bluePin, OUTPUT);
}

void setColor(int red, int green, int blue) {
  analogWrite(redPin, red);
  analogWrite(greenPin, green);
  analogWrite(bluePin, blue);
}

void loop() {
  // Red
  setColor(255, 0, 0);
  delay(1000);

  // Orange
  setColor(255, 127, 0);
  delay(1000);

  // Yellow
  setColor(255, 255, 0);
  delay(1000);

  // Green
  setColor(0, 255, 0);
  delay(1000);

  // Turquoise
  setColor(0, 206, 209);
  delay(1000);

  // Blue
  setColor(0, 0, 255);
  delay(1000);

  // Indigo
  setColor(75, 0, 130);
  delay(1000);
  
   // Violet
  setColor(148, 0, 211);
  delay(1000);
  
   // Pink
  setColor(255, 20, 147);
  delay(1000);
}
